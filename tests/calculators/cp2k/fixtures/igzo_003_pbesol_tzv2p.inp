&GLOBAL
  PROJECT igzo_003_pbesol_tzv2p
  RUN_TYPE ENERGY_FORCE
  PRINT_LEVEL MEDIUM
&END GLOBAL

&FORCE_EVAL
  METHOD QUICKSTEP

  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH

    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
    &END QS

    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
    &END MGRID

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-6
      MAX_SCF 100
      &OT
        MINIMIZER CG
        PRECONDITIONER FULL_SINGLE_INVERSE
      	ENERGY_GAP 0.001
      &END OT
      &OUTER_SCF
        EPS_SCF 1.0E-6
        MAX_SCF 10
      &END OUTER_SCF
    &END SCF

    &XC
      &XC_FUNCTIONAL
        &GGA_X_PBE_SOL
        &END GGA_X_PBE_SOL
        &GGA_C_PBE_SOL
        &END GGA_C_PBE_SOL
      &END XC_FUNCTIONAL
    &END XC
  &END DFT

  &SUBSYS
    &CELL
      A 3.299000000000 0.000000000000 0.000000000000
